<Project>

  <PropertyGroup>
    <!-- Every project writes a packages.lock.json, pinning the full transitive closure
         to exact versions and content hashes. CI restores in locked mode, so a
         dependency that resolves differently than the committed lock file fails the
         build instead of silently shipping. Regenerate after a deliberate package
         change with: dotnet restore AzureEgressProxy.slnx /p:RestoreForceEvaluate=true -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
