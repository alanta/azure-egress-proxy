@model Portal.Components.ChartModel
@* Server-rendered SVG, as everything else on this console is — no charting library, so nothing
   here implies npm in the repo or unsafe-eval in the CSP.

   The baseline is drawn because at this size a reader judges the shape against zero. The label
   doubles as the accessible name and as the grain statement: these are 1-minute samples and the
   console says so rather than letting the shape imply a live feed (design.md D4). *@
@if (Model.HasData)
{
    <svg viewBox="0 0 @Model.Width @Model.Height" width="100%" height="@Model.Height"
         preserveAspectRatio="none" role="img" aria-label="@Model.Label">
        <line x1="0" y1="@(Model.Height - 3)" x2="@Model.Width" y2="@(Model.Height - 3)"
              stroke="currentColor" stroke-opacity=".12" stroke-width="1"></line>
        <path d="@Model.AreaPath" fill="@Model.Colour" fill-opacity=".14"></path>
        <path d="@Model.LinePath" fill="none" stroke="@Model.Colour" stroke-width="1.5"
              stroke-linejoin="round"></path>
    </svg>
}
else
{
    <div class="note dim">No samples in this window.</div>
}
