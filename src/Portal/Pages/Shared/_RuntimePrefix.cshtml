@model Portal.Pages.RuntimeModel
@{
    var pool = Model.Pool;
    var slots = Model.PoolSlots;
}
@*  Swap target 3 of 4: the scale-set→prefix duct, the prefix station, the prefix lane, and the
    outlet duct on to the partner endpoints.

    The stage this surface exists for. The proxy egresses from instance-level public IPs drawn from
    a prefix, not from a NAT gateway, so the prefix — not any individual node — is the stable set of
    addresses partners allowlist on their side. "How full is it" therefore has a consequence outside
    this deployment, and that consequence is the bar below the deck rather than a footnote here.

    This stage owns two ducts: the one entering it, and the trailing one out to the partner
    endpoints, because there is no stage beyond it (design.md D2).

    `display: contents` — see _RuntimeLoadBalancer for why. Refreshes against the cache. *@
<div hx-get="/Runtime?handler=PrefixStage" hx-trigger="every 60s" hx-swap="outerHTML"
     style="display:contents">
    <partial name="_RuntimeDuct" model="Model.EgressDuct" />
    <partial name="_RuntimeStation" model="Model.PrefixStage" />
    <partial name="_RuntimeDuct" model="Model.OutletDuct" />

    <div class="sx-lane a-pip">
        <div class="sx-lane-tag">Egress prefix · ARM</div>
        @if (pool is null)
        {
            <div class="note dim">
                No egress IP prefix is configured for this deployment, or it is not readable by the
                portal's identity. This is not the same as a prefix with nothing assigned.
            </div>
        }
        else
        {
            <div class="sx-stats">
                <partial name="_Stat" model="@(new StatModel(
                    pool.InUse.ToString(), "addresses assigned", StatTone.Neutral, $"/{pool.Capacity}"))" />
                @* Spare capacity is a headcount, not a percentage: it is how many more nodes can
                   exist before one of them egresses from an unallowlisted address. *@
                <partial name="_Stat" model="@(new StatModel(
                    pool.Available.ToString(), "spare · nodes the fleet can still add", Model.PoolTone))" />
            </div>

            @if (slots.Count > 0)
            {
                <div class="pool">
                    @foreach (var slot in slots)
                    {
                        @* Assigned addresses the console cannot attribute to a node are still drawn
                           as in use — the prefix's own count is authoritative, and under-reporting
                           how full the pool is is the one error this stage must not make. *@
                        <div class="ip@(slot.InUse ? " used" : "")"
                             title="@(slot.Address ?? slot.Label) @(slot.Node is null
                                 ? (slot.InUse ? "· assigned" : "· spare")
                                 : $"· {slot.Node}")">@slot.Label</div>
                    }
                </div>
                <div class="legend">
                    <span><i style="background:rgba(47,158,107,.35)"></i> In use</span>
                    <span><i style="background:rgba(255,255,255,.7); border:1px solid var(--line)"></i> Spare</span>
                    @if (pool.Prefix is { } prefix)
                    {
                        <span class="mono">@prefix</span>
                    }
                </div>
            }
            else if (pool.Capacity > 0)
            {
                @* A prefix too large to draw address by address still gets its numbers and its
                   consequence; only the grid is dropped. *@
                <p class="note dim" style="margin:0">
                    /@pool.PrefixLength holds @pool.Capacity addresses — too many to draw
                    individually. The counts above are the whole story.
                </p>
            }

            @if (Model.PrefixFreshness is { } freshness)
            {
                <partial name="_Freshness" model="freshness" />
            }
        }
    </div>
</div>
