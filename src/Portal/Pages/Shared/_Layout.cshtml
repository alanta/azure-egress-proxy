@using Portal.Auth
@using Portal.Components
@inject IPortalUserAccessor Operator
@{
    var current = (ViewData["Surface"] as string) ?? Surface.Overview.Key;
    var who = Operator.Current?.DisplayName ?? "";
    var initials = string.Concat(who.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(part => char.ToUpperInvariant(part[0])));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Egress console</title>
    @* SVG only, and self-hosted: img-src is 'self' data:, and the mark is vector artwork that
       has no raster fallback in the repo. Every browser the console targets renders it. *@
    <link rel="icon" href="~/img/icon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/portal.css" />
</head>
@* hx-boost turns the tab bar's ordinary links into partial swaps while keeping them real routes,
   so the console gets deep links and the back button — which the mockup's JS tab switching does
   not. data-surface selects the per-surface background tint. *@
@* hx-indicator is inherited, so naming the bar once on <body> covers every request htmx makes:
   boosted tab navigation, the traffic filters, the ruleset detail swap, the 60s panel polls. htmx
   puts .htmx-request on this element for the life of the request and takes it off again, so the
   bar needs no script of its own — which matters, because the CSP grants no unsafe-eval and the
   console ships no JavaScript beyond htmx itself.

   Reads as progress, not as a result: the console must never look like it is telling an operator
   something about their egress posture when it is only telling them it is still fetching. *@
<body hx-boost="true" data-surface="@current" hx-indicator="#page-progress">
    @* Decorative, and hidden from assistive technology on purpose: the alternative — a live
       region holding the word "Loading" — sits in the DOM permanently and gets announced on every
       page load whether or not anything is loading. Saying it once, untruthfully, is worse than
       not saying it. The swapped content is what carries the answer. *@
    <div id="page-progress" class="page-progress" aria-hidden="true"></div>
    <header class="shell">
        <div class="brand">
            <img class="chip" src="~/img/icon.svg" alt="" width="38" height="38" />
            <div class="wordmark"><div>Egress</div><div>Proxy</div><div>Console</div></div>
        </div>
        <nav class="tabs" aria-label="Console surfaces">
            <div class="tabgroup">
                @foreach (var surface in Surface.All)
                {
                    <a class="tab" href="@surface.Path"
                       aria-current="@(surface.Key == current ? "page" : null)"
                       aria-selected="@(surface.Key == current ? "true" : "false")">@surface.Label</a>
                }
            </div>
        </nav>
        <div class="headerside">
            <div class="whoami">
                <div class="av" aria-hidden="true">@initials</div>
                <div>
                    <div class="who">@who</div>
                    <div class="role">Platform team</div>
                </div>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    @* Vendored and pinned — no CDN in the trust path of a security reference implementation.
       The version is in the filename so an upgrade cannot be served from a stale cache.
       See wwwroot/lib/htmx/README.md for provenance and the upgrade procedure. *@
    <script src="~/lib/htmx/htmx-2.0.10.min.js"></script>
</body>
</html>
