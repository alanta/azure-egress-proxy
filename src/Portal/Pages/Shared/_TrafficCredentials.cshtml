@model Portal.Pages.TrafficModel
@*
    8.5 — a CANONICAL-PROXY-DECISION row with an EMPTY Role: credentials were presented and
    rejected. This is not the 407 handshake in the panel beside it, and the two must not blur: the
    split keys on the event type plus the presence of a role, never on the reason text, because a
    reason match would hide authentication failures behind ordinary handshake noise.
*@
@{
    @* One row per source and destination, carrying the distinct reasons observed for it. The
       attempt count belongs to the group, not to any one reason, so it is not divided among them —
       the query cannot say how the attempts split and the panel must not imply that it can. *@
    IReadOnlyList<IReadOnlyList<CellModel>> rows =
    [
        .. Model.AuthFailures.Select(group => (IReadOnlyList<CellModel>)
        [
            new CellModel(group.SourceIp, Mono: true),
            new CellModel(group.Host, Mono: true),
            new CellModel(group.Reasons.Count == 0
                ? "(no reason recorded)"
                : string.Join(" · ", group.Reasons)),
            new CellModel(group.Attempts.ToString("N0"), Numeric: true, Tone: StatTone.Warn),
        ])
    ];
}
<div hx-get="@Model.FilterUrl("CredentialsPanel")" hx-trigger="every 60s" hx-swap="outerHTML">
    <console-card eyebrow="Credentials refused" title="A token was presented and rejected" icon="🔑">
        @if (!Model.TrafficConfigured)
        {
            <div class="note dim">No audit workspace is configured, so nothing has been checked.</div>
        }
        else
        {
            <partial name="_DataTable" model="@(new TableModel(
                [new ColumnModel("Source"), new ColumnModel("Destination"), new ColumnModel("Reason"),
                 new ColumnModel("Attempts", Numeric: true)],
                rows,
                Scroll: true,
                EmptyMessage: $"No credential was refused in the {Model.Window.Label()}."))" />

            <p class="note" style="margin:14px 0 0">
                These are distinct from the 407 challenge every connection begins with. A refusal
                means credentials <strong>were</strong> sent and did not pass — an expired token, a
                wrong audience, an unknown issuer. The proxy writes the real cause onto the row, so
                the reason here is its own, not a guess made at render time.
            </p>

            @if (Model.Summary is not null)
            {
                <div style="margin-top:12px">
                    <partial name="_Freshness" model="@FreshnessModel.From(Model.Summary.Freshness)" />
                </div>
            }
        }
    </console-card>
</div>
